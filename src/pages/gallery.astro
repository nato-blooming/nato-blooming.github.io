---
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photo_pages');
const photos = allPhotos.map(p => ({
  slug: p.slug,
  image: p.data.image,
  title: p.data.title
}));
---

<section id="gallery" class="gallery-grid"></section>

<script
  type="application/json"
  is:inline
  set:html={JSON.stringify(photos)}
  id="photo-data"
></script>

<script type="module">
  function shuffle(array) {
    for (let i = array.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
  }

  document.addEventListener("DOMContentLoaded", () => {
    const raw = document.getElementById("photo-data")?.textContent;
    if (!raw) {
      console.error("photo-data not found or empty");
      return;
    }

    const photos = JSON.parse(raw);
    const shuffled = shuffle(photos).slice(0, 8); // 任意で表示数制限
    const container = document.getElementById("gallery");

    shuffled.forEach(photo => {
      const a = document.createElement("a");
      a.href = `/photo_pages/${photo.slug}`;
      a.className = "block overflow-hidden rounded shadow hover:shadow-lg transition";

      const img = document.createElement("img");
      img.src = photo.image;
      img.alt = photo.title || "ギャラリー写真";
      img.className = "w-full h-48 object-cover";

      a.appendChild(img);
      container.appendChild(a);
    });
  });
</script>
