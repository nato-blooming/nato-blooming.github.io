---
import { getCollection } from 'astro:content';

const allPhotos = await getCollection('photo_pages');
const photos = allPhotos.map(p => ({
  slug: p.slug,
  image: p.data.image,
  title: p.data.title
}));
---

<!-- ギャラリーセクション：Tailwindグリッド -->
<section id="gallery" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4 p-4"></section>

<!-- JSONデータ埋め込み（is:inline + set:html）-->
<script 
  type="application/json" 
  is:inline 
  set:html={JSON.stringify(photos)} 
  id="photo-data">
</script>

<!-- クライアントJS -->
<script type="module">
  document.addEventListener("DOMContentLoaded", () => {
    const raw = document.getElementById("photo-data")?.textContent;
    if (!raw) {
      console.error("photo-data not found or empty");
      return;
    }

    // シャッフル関数
    function shuffle(array) {
      for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
      }
      return array;
    }

    const photos = shuffle(JSON.parse(raw)); // ランダム表示
    const container = document.getElementById("gallery");

    photos.forEach(photo => {
      const a = document.createElement("a");
      a.href = `/photo_pages/${photo.slug}`;
      a.className = "block overflow-hidden rounded shadow hover:shadow-lg transition aspect-[3/2]";

      const img = document.createElement("img");
      img.src = photo.image;
      img.alt = photo.title || "ギャラリー写真";
      img.className = "w-full h-full object-cover";

      a.appendChild(img);
      container.appendChild(a);
    });
  });
</script>
