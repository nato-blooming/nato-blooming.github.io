---
export const prerender = true

import { getCollection, getEntryBySlug } from 'astro:content'
import DefaultPageLayout from '$/layouts/default.astro'
import CategoryOverview from '$/components/CategoryOverview.astro'


const title = 'ホーム'
const description = 'ようこそ！'
---
<DefaultPageLayout content={{ title, description }} showPageHeader={false}>

<section class="category-section">
  <h2 class="text-3xl font-bold mb-6 text-center">ようこそ！</h2>
  <h2 class="text-l font-bold mb-6 text-center">有志による牛久観光サイトです。</h2>

  <div class="grid gap-6 grid-cols-2">
    <!-- 観光・グルメ -->
    <div class="card">
      <div class="card-content">
        <div class="card__icon">📍</div>
        <h3 class="card_name">観光・グルメ</h3>
      </div>
      <div class="grid grid-cols-2 gap-2 mt-2 text-sm">
        <a class="subbtn" href="/spot_note">リスト</a>
        <a class="subbtn" href="/tags">タグ</a>
        <a class="subbtn" href="/map">地図</a>
        <span class="subbtn opacity-50 cursor-default">準備中</span>
      </div>
    </div>

    <!-- モデルコース -->
    <div class="card">
      <div class="card-content">
        <div class="card__icon">🐾</div>
        <h3 class="card_name">モデルコース</h3>
        <p class="sub_sentence">おすすめルートを紹介。<br>牛久の魅力を巡ろう！</p>
      </div>
      <a class="linkbtn mt-3" href="/course">見る →</a>
    </div>

    <!-- ギャラリー -->
    <div class="card opacity-60">
      <div class="card-content">
        <div class="card__icon">📷</div>
        <h3 class="card_name">ギャラリー</h3>
        <p class="sub_sentence">日常・景色写真<br>（準備中）</p>
      </div>
      <!--
      <a class="linkbtn mt-3" href="/course">見る →</a>
      -->
    </div>

    <!-- リンク集 -->
    <div class="card">
      <div class="card-content">
        <div class="card__icon">🔗</div>
        <h3 class="card_name">リンク集</h3>
        <p class="sub_sentence">外部サイトまとめ</p>
      </div>
      <a class="linkbtn mt-3" href="/links">見る →</a>
    </div>
  </div>
</section>

</DefaultPageLayout>

<style>
  .category-section {
    @apply py-4 px-1;
  }

  .grid-wrapper {
    @apply grid grid-cols-2 gap-1;
  }

  .card {
    @apply justify-between p-3 border border-gray-300 dark:border-gray-600 rounded-md bg-gray-100 dark:bg-gray-800 flex flex-col items-center text-center;
  }

  .card__icon {
    @apply text-3xl mb-1;
  }

  .subbtn-row {
    @apply grid grid-cols-2 gap-1 w-full mt-2;
  }

  .subbtn {
    @apply w-full bg-blue-600 text-white text-base rounded px-[0.25rem] py-0.5 text-center hover:bg-blue-700;
  }

  .linkbtn {
    @apply mt-auto self-end text-blue-500 hover:underline block mt-2 text-sm;
  }

  .card_name {
    @apply text-xl font-semibold;
  }

  .sub_sentence {
    @apply text-xs py-1;
  }
</style>

